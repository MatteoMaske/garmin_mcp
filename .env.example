# Copy to .env and fill in only what you need.
#
# Recommended: do NOT put credentials here. Run `uv run garmin-mcp-auth` once
# instead; it saves OAuth tokens to ~/.garminconnect and the server needs no
# secrets in its environment afterwards.
#
# GARMIN_EMAIL you@example.com
# GARMIN_PASSWORD changeme

# Use Garmin Connect China (garmin.cn) instead of the international site.
# GARMIN_IS_CN=true

# Where download_activity_file saves FIT/GPX/TCX/CSV files.
# GARMIN_FIT_DOWNLOAD_DIR=/absolute/path/to/downloads

# Token store location (default ~/.garminconnect). Point at a separate
# directory to run a second Garmin account as its own server instance.
# GARMINTOKENS=/absolute/path/to/.garminconnect-account2

# Transport: stdio (default) | streamable-http | sse
# GARMIN_MCP_TRANSPORT=streamable-http
# GARMIN_MCP_HOST=127.0.0.1
# GARMIN_MCP_PORT=8000

# Expose only a subset of the 153 tools to reduce LLM context, e.g. read-only:
# GARMIN_ENABLED_TOOLS=get_activities,get_activity,get_activity_splits
# GARMIN_DISABLED_TOOLS=delete_workout,delete_course
